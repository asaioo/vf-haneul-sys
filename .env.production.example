# Public HTTPS origin served by your reverse proxy. No trailing path.
APP_ORIGIN=https://vf-kapo.example.com

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# GitHub App / OAuth values. The PEM path is supplied by compose.yaml.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY_ID=
GITHUB_PROJECT_NODE_ID=
BOOTSTRAP_GITHUB_IDS=

TASK_PREFIX=TASK

# Explicit governance opt-in.
GOVERNANCE_ENABLED=true
GOVERNANCE_AGENT_LOGINS=
GOVERNANCE_MODEL_API_KEY=
GOVERNANCE_MODEL_BASE_URL=https://api.openai.com/v1
GOVERNANCE_MODEL=
GOVERNANCE_MODEL_DISABLE_THINKING=false
GOVERNANCE_PRIVATE_CODE_OPT_IN=true
