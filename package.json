{
  "name": "vf-kapo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:client": "vite build --watch",
    "dev:server": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "start:prod": "node dist/server/src/server/main.js",
    "demo": "tsx src/server/main.ts --demo",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "test:browser": "playwright test",
    "backup": "tsx src/server/backup.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typebox": "1.3.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
