# No credentials are provided. Supply these through protected deployment configuration.
NODE_ENV=production
APP_ORIGIN=https://kapo.example.com
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/kapo/kapo.sqlite
TOKEN_ENCRYPTION_KEY=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPOSITORY_ID=
GITHUB_INSTALLATION_ID=
# GraphQL node ID for the single organization-owned Projects v2 pilot project (PVT_...).
GITHUB_PROJECT_NODE_ID=
BOOTSTRAP_GITHUB_IDS=
# Retained only for legacy database compatibility; GitHub Issue numbers are authoritative.
TASK_PREFIX=TASK


# Governance is opt-in. A request is never sent to a model without all of
# these values and explicit private-code transmission consent.
GOVERNANCE_ENABLED=false
GOVERNANCE_MODEL_ENABLED=false
GOVERNANCE_MODEL_API_KEY=
# OpenAI-compatible API root, for example http://HOST:PORT/v1
GOVERNANCE_MODEL_BASE_URL=https://api.openai.com/v1
GOVERNANCE_MODEL=
# Set true only for compatible reasoning servers that otherwise consume the entire output budget before JSON.
GOVERNANCE_MODEL_DISABLE_THINKING=false
OPENAI_API_KEY=
OPENAI_MODEL=
GOVERNANCE_PRIVATE_CODE_OPT_IN=false
